<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RoslynVersion>4.14.0</RoslynVersion>
    <!-- ISourceGenerator is marked obsolete in Roslyn 4.14. The compiler still runs it.
         Incremental generators are a separate change. -->
    <NoWarn>$(NoWarn);RS1042</NoWarn>
  </PropertyGroup>

  <Import Project="Avatar.StaticProxy.targets"/>

</Project>
