<Project Sdk="Microsoft.Build.NoTargets/3.7.134" DefaultTargets="Pack">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- NoTargets 3.7 excludes these projects from generated solutions. This one is the package project. -->
    <IncludeInSolutionFile>true</IncludeInSolutionFile>
    <PackageId>Stunts</PackageId>
    <Title>Stunts</Title>
    <Description>Stunts is a modern interception library which implements the proxy pattern 
and runs everywhere, even where run-time code generation (Reflection.Emit) is forbidden or 
limitted, like physical iOS devices and game consoles, through compile-time code generation. 
The proxy behavior is configured in code using what we call a behavior pipeline.

      IMyService service = Stunt.Of&lt;IMyService&gt;();
service.AddBehavior(...);
    </Description>
    <PackageTags>dotnet proxy runtime dynamic</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Stunt.cs" CodeLanguage="cs" TargetFramework="netstandard2.0" BuildAction="Compile" />
    <Content Include="Stunt.vb" CodeLanguage="vb" TargetFramework="netstandard2.0" BuildAction="Compile" />
    <None Include="Stunt.StaticFactory.*" PackFolder="build\netstandard2.0" />
    <None Include="*.props;*.targets" Exclude="Stunts.Version.props" PackFolder="build\netstandard2.0" />
    <!-- Default items still include the unversioned file. Only the poked copy in obj should ship. -->
    <None Remove="Stunts.Version.props" />
    <PackageFile Include="@(None)" Exclude="@(None -> WithMetadataValue('Filename', 'readme'))" PackFolder="buildTransitive\netstandard2.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="NuGetizer" Version="$(DogfoodingVersion)" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\nugetizer\bin\')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stunts\Stunts.csproj" />
    <ProjectReference Include="..\Stunts.CodeAnalysis\Stunts.CodeAnalysis.csproj" AdditionalProperties="IsPackable=false" />
    <ProjectReference Include="..\Stunts.DynamicProxy\Stunts.DynamicProxy.csproj" AdditionalProperties="IsPackable=false" />
    <ProjectReference Include="..\Stunts.StaticProxy\Stunts.StaticProxy.csproj" AdditionalProperties="IsPackable=false" />
  </ItemGroup>
  <Target Name="CopyVersion" Inputs="Stunts.Version.props" Outputs="$(IntermediateOutputPath)Stunts.Version.props">
    <Copy SourceFiles="Stunts.Version.props" DestinationFiles="$(IntermediateOutputPath)Stunts.Version.props" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="UpdateVersionProps" DependsOnTargets="CopyVersion" BeforeTargets="GetPackageContents">
    <!-- Update Stunts.Version.props -->
    <PropertyGroup>
      <XmlNs>&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003'/&gt;</XmlNs>
    </PropertyGroup>
    <XmlPoke Namespaces="$(XmlNs)"
				 XmlInputPath="$(IntermediateOutputPath)Stunts.Version.props"
				 Query="/msb:Project/msb:PropertyGroup/msb:StuntsVersion"
				 Value="$(Version)"/>
    <ItemGroup>
      <PackageFile Include="$(IntermediateOutputPath)Stunts.Version.props" PackFolder="build\netstandard2.0" />
      <PackageFile Include="$(IntermediateOutputPath)Stunts.Version.props" PackFolder="buildTransitive\netstandard2.0" />
    </ItemGroup>
  </Target>
</Project>