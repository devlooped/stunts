<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <!-- Shipped next to the analyzer. Workspaces is supplied by the IDE, not by this package. -->
    <PackFolder Condition="'$(IsPackable)' != 'true'">analyzers\dotnet</PackFolder>
    <NoWarn>$(NoWarn);RS1038</NoWarn>
    <Description>Code fixes for the Stunts analyzer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" Pack="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="5.0.0" Pack="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stunts.CodeAnalysis\Stunts.CodeAnalysis.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
