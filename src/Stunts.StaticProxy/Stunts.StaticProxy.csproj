<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <!-- ISourceGenerator is obsolete in Roslyn 4.14 (RS1042). Extended analyzer rules also ban
         that API and the assembly probing in DependencyResolver (RS1035). Incremental generators
         are a separate change, so RS1036 stays suppressed until then. -->
    <NoWarn>$(NoWarn);RS1042;RS1036</NoWarn>
  </PropertyGroup>

  <Import Project="Stunts.StaticProxy.targets"/>

  <ItemGroup>
    <!-- Emitted into compilations that proxy a ref struct or pointer. netstandard2.0 cannot compile it. -->
    <Compile Remove="SignatureRef.cs" />
    <EmbeddedResource Include="SignatureRef.cs" />
  </ItemGroup>

</Project>
