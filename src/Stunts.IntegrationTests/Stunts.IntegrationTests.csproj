<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net48;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectProperty Include="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <PackageReference Include="Superpower" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup Label="Targets">
    <PackageReference Include="Microsoft.ApplicationInsights" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="2.17.0" />
  </ItemGroup>

  <ItemGroup Label="net10 Targets" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="5.0.5" />

    <PackageReference Include="Microsoft.AspNetCore.Mvc" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="net48 Targets" Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="EntityFramework" />
    <PackageVersion Include="EntityFramework" Version="6.4.4" />

    <PackageReference Include="Microsoft.AspNet.Mvc" />
    <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.2.7" />

    <PackageReference Include="Microsoft.AspNet.WebApi" />
    <PackageVersion Include="Microsoft.AspNet.WebApi" Version="5.2.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stunts\Stunts.csproj" />
    <ProjectReference Include="..\Stunts.CodeAnalysis\Stunts.CodeAnalysis.csproj" />
    <ProjectReference Include="..\Stunts.DynamicProxy\Stunts.DynamicProxy.csproj" />
    <ProjectReference Include="..\Stunts.StaticProxy\Stunts.StaticProxy.csproj" />
    <ProjectReference Include="..\ManualStunts\ManualStunts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Stunts.Package\Stunt.cs" Link="Stunt\Stunt.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
