<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="bin" value="../../bin" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Overrides any user-level mapping, which would otherwise exclude the local bin source -->
  <packageSourceMapping>
    <clear />
    <packageSource key="bin">
      <package pattern="Stunts*" />
      <package pattern="ManualStunts" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
