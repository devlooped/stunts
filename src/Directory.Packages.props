<Project>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="NuGetizer" PrivateAssets="all" Visible="false" />
    <PackageReference Include="ThisAssembly" PrivateAssets="all" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="ThisAssembly" Version="2.1.5" />
    <PackageVersion Include="NuGetizer" Version="1.5.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
    <!-- Required to unify this dependency across projects. -->
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />

    <!-- When running under .netframework, this dependency will be needed -->
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
    
    <!-- For packaging purposes -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />

    <!-- Native SQLite for tests on macOS. 3.x drops the vulnerable SQLitePCLRaw.lib.e_sqlite3 package. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <!-- Transitive pins so restore does not keep vulnerable versions. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.10.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.console" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.msbuild" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="MSBuild">
    <PackageVersion Include="Microsoft.Build" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.246" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageVersion Include="TypeNameFormatter.Sources" Version="1.1.2" />
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <PackageVersion Include="Superpower" Version="3.2.1" />
    <PackageVersion Include="docfx.console" Version="2.59.4" />
  </ItemGroup>

</Project>
