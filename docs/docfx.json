{
  "$schema": "http://json.schemastore.org/docfx",
  "metadata": [
    {
      "src": [
        {
          "files": [ "*.cs" ],
          "src": "../src/Stunts"
        }
      ],
      "dest": "docs/api",
      "filter": "filter.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.yml",
          "index.md"
        ], 
        "src": "api",
        "dest": "api"
      },

      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "logo.svg",
          "favicon.ico",
          "favicon/*.*",
          "assets/**/*.*"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "Stunts",
      "_rel": "/stunts/",
      "_enableSearch": true
    },
    "template": [
      "default",
      "./template"
    ],    
    "dest": "_site"
  }
}
