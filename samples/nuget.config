<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="bin" value="../bin" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bin">
      <package pattern="Stunts*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>